/* ---------- 头部 ---------- */
.hero {
  position: relative;
  overflow: hidden;
  padding: 0 32rpx 40rpx;
  background: linear-gradient(180deg, #EFF4FF 0%, #F5F7FB 100%);
}
.glow {
  position: absolute;
  right: -140rpx;
  top: -180rpx;
  width: 460rpx;
  height: 460rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(46, 107, 246, 0.16) 0%, rgba(46, 107, 246, 0) 68%);
}

.brand {
  position: relative;
  display: flex;
  align-items: center;
  height: 88rpx;
}
.brand-mark {
  width: 34rpx;
  height: 34rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #4C87FF, #2E6BF6);
  margin-right: 12rpx;
  box-shadow: 0 4rpx 10rpx rgba(46, 107, 246, 0.34);
}
.brand-name {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #101522;
}
.brand-ver {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #8A93A6;
  letter-spacing: 1rpx;
}

.hero-main {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.hero-copy {
  flex: 1;
  min-width: 0;
}
.h1 {
  font-size: 50rpx;
  line-height: 1.34;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  color: #0D121D;
}
.h1-hl {
  color: #2E6BF6;
}
.h2 {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #6E7A90;
  letter-spacing: 0.5rpx;
}

/* 三张迷你证件照示意 */
.demos {
  display: flex;
  align-items: center;
  padding-right: 4rpx;
}
.demo {
  position: relative;
  width: 86rpx;
  height: 116rpx;
  border-radius: 8rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 18rpx rgba(16, 21, 34, 0.16);
  border: 1rpx solid rgba(16, 21, 34, 0.06);
}
.demo + .demo {
  margin-left: -22rpx;
}
.demo:nth-child(1) {
  transform: rotate(-7deg);
}
.demo:nth-child(2) {
  transform: translateY(-8rpx);
  z-index: 2;
}
.demo:nth-child(3) {
  transform: rotate(7deg);
}
.demo-head {
  position: absolute;
  left: 50%;
  top: 22rpx;
  width: 34rpx;
  height: 34rpx;
  margin-left: -17rpx;
  border-radius: 50%;
  background: rgba(24, 33, 51, 0.5);
}
.demo-body {
  position: absolute;
  left: 50%;
  bottom: -18rpx;
  width: 74rpx;
  height: 52rpx;
  margin-left: -37rpx;
  border-radius: 40rpx 40rpx 0 0;
  background: rgba(24, 33, 51, 0.5);
}

.chips {
  display: flex;
  margin-top: 26rpx;
}
.chip {
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 44rpx;
  color: #33508C;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(46, 107, 246, 0.16);
}
.chip + .chip {
  margin-left: 12rpx;
}

/* ---------- 主体 ---------- */
.body {
  padding: 8rpx 32rpx calc(240rpx + env(safe-area-inset-bottom));
}
.mt40 {
  margin-top: 40rpx;
}

.hot-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.hcard {
  position: relative;
  width: 48.6%;
  margin-bottom: 20rpx;
  padding: 26rpx 24rpx 26rpx;
  background: #fff;
  border-radius: 22rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(16, 21, 34, 0.04);
  transition: all 0.16s ease;
}
.hcard.on {
  border-color: #2E6BF6;
  background: #F4F8FF;
  box-shadow: 0 8rpx 22rpx rgba(46, 107, 246, 0.16);
}
.hcard-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hcard-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #101522;
  letter-spacing: 1rpx;
}
.hcard.on .hcard-name {
  color: #1D50CE;
}
.hcard-tag {
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  line-height: 34rpx;
  color: #2E6BF6;
  background: rgba(46, 107, 246, 0.1);
}
.hcard-mm {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #4A5364;
  font-variant-numeric: tabular-nums;
}
.hcard-use {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #98A1B2;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.more-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.mcard {
  width: 31.6%;
  margin-bottom: 18rpx;
  padding: 22rpx 10rpx;
  text-align: center;
  background: #fff;
  border-radius: 18rpx;
  border: 2rpx solid transparent;
}
.mcard.on {
  border-color: #2E6BF6;
  background: #F4F8FF;
}
.mcard-name {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #101522;
}
.mcard.on .mcard-name {
  color: #1D50CE;
}
.mcard-mm {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #98A1B2;
  font-variant-numeric: tabular-nums;
}

.pn-strong {
  font-weight: 600;
  color: #1D50CE;
}

.foot-links {
  margin-top: 34rpx;
  padding-bottom: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #98A1B2;
  text-decoration: underline;
}

/* ---------- 自定义尺寸 ---------- */
.custom-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border: 2rpx dashed #C9D6EC;
  border-radius: 20rpx;
}
.cc-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #101522;
}
.cc-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #98A1B2;
}
.cc-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: #C3CEE2;
}

.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(16, 21, 34, 0.45);
}
.modal {
  width: 100%;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
}
.modal-hd {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  color: #101522;
}
.modal-bd {
  margin-top: 26rpx;
}
.unit-row {
  display: flex;
  padding: 6rpx;
  background: #F1F4F9;
  border-radius: 14rpx;
}
.unit {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 25rpx;
  color: #5C6678;
  border-radius: 10rpx;
}
.unit.on {
  background: #fff;
  color: #101522;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(16, 21, 34, 0.08);
}
.input-row {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}
.ipt {
  flex: 1;
  height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  color: #101522;
  background: #F5F7FB;
  border-radius: 14rpx;
}
.ipt-x {
  margin: 0 18rpx;
  font-size: 28rpx;
  color: #98A1B2;
}
.modal-tip {
  margin-top: 16rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #98A1B2;
}
.modal-ft {
  display: flex;
  margin-top: 30rpx;
}
.mbtn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  color: #4A5364;
  background: #F1F4F9;
  border-radius: 999rpx;
}
.mbtn + .mbtn {
  margin-left: 18rpx;
}
.mbtn.primary {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #3D7BFF, #2E6BF6);
}
