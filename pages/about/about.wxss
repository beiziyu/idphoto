.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 60rpx;
}

.lead {
  padding: 10rpx 4rpx 34rpx;
}
.lead-t {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.42;
  color: #0D121D;
  letter-spacing: 0.5rpx;
}
.lead-s {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #7C879B;
}

.sec {
  padding: 28rpx 28rpx 30rpx;
  margin-bottom: 20rpx;
}
.sec-h {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.idx {
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  border-radius: 9rpx;
  background: rgba(46, 107, 246, 0.1);
  color: #2E6BF6;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
  flex: 0 0 34rpx;
}
.sec-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #101522;
}
.sec-b {
  font-size: 25rpx;
  line-height: 1.78;
  color: #4A5364;
}
.hl {
  color: #1D50CE;
  font-weight: 600;
}

.li {
  position: relative;
  padding-left: 26rpx;
  margin-bottom: 8rpx;
}
.li::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 20rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #C3CEE2;
}

.foot {
  margin-top: 40rpx;
  text-align: center;
  font-size: 21rpx;
  color: #A8B0BF;
  letter-spacing: 1rpx;
}
.foot-beian {
  margin-top: 8rpx;
  font-size: 19rpx;
  color: #BCC3D0;
}
